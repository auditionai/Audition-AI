{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "auditionai-queue-router",
  "main": "queue-router.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "queues": {
    "producers": [
      { "binding": "ROUTER_QUEUE_GPTI2", "queue": "auditionai-gpti2-jobs-v2" },
      { "binding": "ROUTER_QUEUE_TST", "queue": "auditionai-tst-jobs-v2" }
    ]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
