{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "auditionai-queue-gpti2",
  "main": "queue-gpti2-worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "queues": {
    "producers": [{ "binding": "GPTI2_JOBS", "queue": "auditionai-gpti2-jobs-v2" }],
    "consumers": [{ "queue": "auditionai-gpti2-jobs-v2", "max_batch_size": 8, "max_retries": 3, "max_batch_timeout": 1 }]
  },
  "r2_buckets": [{ "binding": "RESULTS_BUCKET", "bucket_name": "audition-ai-images" }],
  "vars": { "SUPABASE_URL": "https://wnosrdigcdjlrmofxemd.supabase.co", "R2_PUBLIC_URL": "https://media.auditionai.io.vn" },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
