{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "auditionai-api-worker",
  "main": "api-worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    {
      "pattern": "auditionai.io.vn/api/*",
      "zone_name": "auditionai.io.vn"
    }
  ],
  "r2_buckets": [{ "binding": "RESULTS_BUCKET", "bucket_name": "audition-ai-images" }],
  "vars": {
    "SUPABASE_URL": "https://empcvsaskngwesdbhvaj.supabase.co",
    "R2_PUBLIC_URL": "https://media.auditionai.io.vn",
    "NETLIFY_API_ORIGIN": "https://audition-ai.netlify.app",
    "SEPAY_RECONCILE_LIMIT": "10"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
