# Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global
# Dùng GOOGLE_APPLICATION_CREDENTIALS nếu chạy ở máy tính (trỏ đến file)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Dùng GOOGLE_CREDENTIALS_JSON nếu chạy trên Netlify/Render/Vercel
# Copy toàn bộ nội dung file JSON và dán vào đây
GOOGLE_CREDENTIALS_JSON=

# Cloudflare R2 Configuration
# Keep credentials server-only. Never prefix access keys with VITE_.
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your_public_r2_domain
# This public URL is safe for the browser and is only used to recognize R2 assets.
VITE_R2_PUBLIC_URL=your_public_r2_url

# Supabase Database (for metadata)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secondary Supabase (sample prompts)
CAULENHAU_SUPABASE_URL=your_secondary_supabase_url
CAULENHAU_SUPABASE_ANON_KEY=your_secondary_supabase_anon_key

# Trạm Sáng Tạo / Netlify Functions
TST_API_KEY=your_tst_api_key

# xAI Grok (server-only). Defaults to grok-4.5 when GROK_MODEL is omitted.
GROK_API_KEY=your_xai_api_key
GROK_MODEL=grok-4.5

# Gommo secondary provider (server-only; never prefix these with VITE_)
GOMMO_ACCESS_TOKEN=your_gommo_access_token
GOMMO_DOMAIN=vmedia.ai
GOMMO_PROJECT_ID=default
# Current Gommo Jobs gateway. Omit to use this default.
GOMMO_API_BASE=https://v2.api.gommo.net
# Used only when the database setting cannot be read. Admin > Bảng giá controls
# the active provider globally for all newly dispatched jobs.
GENERATION_PROVIDER_DEFAULT=tst
# Optional. Set only when Gommo confirms the monetary value of one credits_ai unit.
# This enables Vcoin-equivalent provider-cost comparison in Admin; it never changes app pricing.
GOMMO_VND_PER_CREDIT=

# Payment gateway selector
PAYMENT_GATEWAY=sepay

# SePay / Netlify Functions
SEPAY_ENV=production
SEPAY_MERCHANT_ID=your_sepay_merchant_id
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_API_TOKEN=your_sepay_user_api_token
SEPAY_PAYMENT_METHOD=BANK_TRANSFER
SEPAY_SUCCESS_URL=https://your-domain.com/topup
SEPAY_ERROR_URL=https://your-domain.com/topup
SEPAY_CANCEL_URL=https://your-domain.com/topup
SEPAY_IPN_URL=https://your-domain.com/api/sepay-ipn

# Telegram notify relay (Cloudflare Worker webhook)
TELEGRAM_NOTIFY_WEBHOOK_URL=https://your-worker-name.your-subdomain.workers.dev
TELEGRAM_NOTIFY_WEBHOOK_SECRET=replace_with_a_long_random_secret
