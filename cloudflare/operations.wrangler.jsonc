{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "auditionai-operations-worker",
  "main": "operations-worker.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "GPTI2_JOBS", "queue": "auditionai-gpti2-jobs-v2" }]
  },
  "vars": { "SUPABASE_URL": "https://empcvsaskngwesdbhvaj.supabase.co" },
  "services": [{ "binding": "TELEGRAM_NOTIFIER", "service": "auditionai-telegram-notify" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
